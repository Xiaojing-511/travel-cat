page {
  height: 100%;
  background: #fffef9;
}

.page {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.inner {
  position: relative;
  z-index: 1;
  height: 100%;
  box-sizing: border-box;
  padding: 140rpx 108rpx 80rpx;
  display: flex;
  flex-direction: column;
}

.date {
  font-size: 24rpx;
  color: #b0a696;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.location {
  font-size: 26rpx;
  color: #8a8173;
  margin-bottom: 28rpx;
  letter-spacing: 2rpx;
  flex-shrink: 0;
}

.photo {
  width: 100%;
  height: 340rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #efe6d4;
  margin-bottom: 36rpx;
  flex-shrink: 0;
}

.photo image {
  width: 100%;
  height: 100%;
}

.journal {
  font-size: 32rpx;
  line-height: 1.9;
  color: #5a5148;
  letter-spacing: 3rpx;
  font-family: "PingFang SC", "Hiragino Maru Gothic ProN", "Hiragino Sans GB", sans-serif;
}
