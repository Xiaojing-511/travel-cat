.page {
  min-height: 100%;
  padding: 24rpx 28rpx 80rpx;
  box-sizing: border-box;
}

.empty,
.loading {
  margin-top: 30vh;
  text-align: center;
  color: #9a9083;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(154, 144, 131, 0.22);
  border-top-color: #9a9083;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  margin-top: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.item {
  display: flex;
  background: #fffcf6;
  border: 2rpx solid rgba(168, 186, 160, 0.45);
  border-radius: 18rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.item-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #efe6d4;
  flex-shrink: 0;
}

.item-photo image {
  width: 100%;
  height: 100%;
}

.item-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 12rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  color: #8a8173;
  letter-spacing: 1rpx;
}

.item-body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 35rpx;
}

.item-loc {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #8a8173;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.item-date {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #b0a696;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.item-journal {
  font-size: 26rpx;
  line-height: 1.6;
  color: #5a5148;
  letter-spacing: 1rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(40, 34, 28, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 36rpx;
  box-sizing: border-box;
}

.postcard {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  height: 86vh;
  max-height: 1080rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 60rpx rgba(40, 34, 28, 0.28);
}

.postcard-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.postcard-inner {
  position: relative;
  z-index: 1;
  height: 100%;
  box-sizing: border-box;
  padding: 88rpx 72rpx 60rpx;
  display: flex;
  flex-direction: column;
}

.date {
  font-size: 24rpx;
  color: #b0a696;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.location {
  font-size: 26rpx;
  color: #8a8173;
  margin-bottom: 28rpx;
  letter-spacing: 2rpx;
  flex-shrink: 0;
}

.photo {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #efe6d4;
  margin-bottom: 28rpx;
  flex-shrink: 0;
}

.photo image {
  width: 100%;
  height: 100%;
}

.journal {
  font-size: 32rpx;
  line-height: 1.9;
  color: #5a5148;
  letter-spacing: 3rpx;
  font-family: "PingFang SC", "Hiragino Maru Gothic ProN", "Hiragino Sans GB", sans-serif;
}
