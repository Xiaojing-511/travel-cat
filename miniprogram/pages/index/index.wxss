page {
  height: 100%;
  background: #ddcebf;
  overflow: hidden;
}

.home {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #ddcebf;
}

.base-bg {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background: #ddcebf;
}

.nav-bar {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  z-index: 4;
  background: #ddcebf;
  pointer-events: none;
}

.home.is-seeking .cat,
.home.is-seeking .cat-bag,
.home.is-seeking .bowls,
.home.is-seeking .travel-remain,
.home.is-seeking .status,
.home.is-seeking .leaf-count,
.home.is-seeking .stocks,
.home.is-seeking .dot,
.home.is-seeking .planters,
.home.is-seeking .welcome,
.home.is-seeking .feed-hint,
.home.is-seeking .leaf-short {
  visibility: hidden;
}

.seek-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(243, 234, 216, 0.46);
}

.seek-text {
  padding: 18rpx 36rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 246, 0.82);
  color: #5c5348;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.world {
  position: absolute;
  top: 0;
  left: -100%;
  width: 200%;
  height: 100%;
  display: flex;
  z-index: 1;
}

.world.is-balcony {
  transform: translateX(50%);
}

.scene {
  position: relative;
  width: 50%;
  height: 100%;
  flex-shrink: 0;
}

/* 背景按宽度等比、贴着屏幕底边。前景也只用这条底边定位，
   不要再加安全区或按屏幕高度的百分比，否则换机型会和画面错开。 */
.bg {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 110%;
  z-index: 0;
}

.balcony-bg{
  width: 120%;
}



.scene-logo {
  position: absolute;
  top: auto;
  bottom: 362rpx;
  z-index: 3;
  width: 160rpx;
  height: 191rpx;
  transform: translateY(-50%);
  scale: 0.5;
  border-radius: 8px;
}

.scene-logo.is-left {
  left: 0rpx;
}

.scene-logo.is-right {
  right: 0rpx;
}

.planters {
  position: absolute;
  left: 70rpx;
  right: 0;
  bottom: 89rpx;
  height: 576rpx;
  z-index: 2;
  pointer-events: none;
  scale: 0.85;
  transform-origin: center center;
}

.planter {
  position: absolute;
  display: block;
  transform: translateX(-50%);
}

.planter-stage {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.planter-stage.is-hide {
  opacity: 0;
}

.planter-stage.is-show {
  opacity: 1;
}

.planter-hint,
.planter-burst,
.planter-pop {
  position: absolute;
  z-index: 6;
  pointer-events: none;
}

.planter-hint {
  animation: planter-hint-bob 1.8s ease-in-out infinite;
  scale: 1.6;
}

.planter-hint-1,
.planter-hint-2,
.planter-hint-3 {
  bottom: 684rpx;
  width: 36rpx;
  height: 36rpx;
  margin-left: -18rpx;
}

.planter-hint-1 {
  left: 204rpx;
}

.planter-hint-2 {
  left: 341rpx;
}

.planter-hint-3 {
  left: 480rpx;
}

.planter-burst {
  width: 0;
  height: 0;
}

.planter-burst-1,
.planter-burst-2,
.planter-burst-3 {
  bottom: 604rpx;
}

.planter-burst-1 {
  left: 204rpx;
}

.planter-burst-2 {
  left: 341rpx;
}

.planter-burst-3 {
  left: 480rpx;
}

.planter-pop {
  width: 28rpx;
  height: 28rpx;
  margin-left: -14rpx;
  margin-bottom: -14rpx;
  animation: planter-leaf-rise 1s ease-out forwards, planter-leaf-fade 1s linear forwards;
}

@keyframes planter-hint-bob {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

@keyframes planter-leaf-rise {
  0% {
    transform: translateY(0) scale(0.72);
  }
  100% {
    transform: translateY(-30rpx) scale(1);
  }
}

@keyframes planter-leaf-fade {
  0%,
  82% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}

.planter-1,
.planter-2,
.planter-3 {
  bottom: 464rpx;
  width: 214rpx;
  height: 232rpx;
}

.planter-1 {
  left: 204rpx;
  z-index: 3;
}

.planter-2 {
  left: 341rpx;
  z-index: 2;
}

.planter-3 {
  left: 480rpx;
  z-index: 1;
}

.scene-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  background: #000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 400ms linear;
}

.scene-mask.is-on {
  opacity: 1;
}

.scene-mask.is-busy {
  pointer-events: auto;
}

.hud {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 5;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.status-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-remain {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(106, 122, 98, 0.7);
  letter-spacing: 1rpx;
}

.status {
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 246, 0.82);
  color: #6a7a62;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.sides {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 0 20px;
}

.side-left {
  min-width: 72rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  overflow: visible;
}

.leaf-bar {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-bottom: 8rpx;
  margin-top: 10rpx;
}

.leaf-bar-hover {
  opacity: 0.72;
}

.leaf-logo {
  width: 56rpx;
  height: 56rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.leaf-meta {
  display: flex;
  align-items: center;
  margin-left: 4rpx;
  border-radius: 999rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(90, 70, 40, 0.1);
}

.leaf-count {
  min-width: 52rpx;
  height: 40rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  background: rgba(255, 252, 246, 0.92);
  color: #5f6d58;
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
}

.leaf-plus {
  width: 44rpx;
  height: 40rpx;
  display: flex;
  /* align-items: center; */
  justify-content: center;
  background: #8aa382;
  color: #fffdf8;
  font-size: 32rpx;
  line-height: 1;
  flex-shrink: 0;
}

.sound {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sound-hover {
  opacity: 0.72;
}

.sound-logo {
  width: 50rpx;
  height: 50rpx;
  display: block;
}

.tools-row {
  display: flex;
  gap: 20rpx;
  flex-direction: column;
  align-items: end;
}

.feed-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.feed-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 12rpx;
}

.feed-anchor {
  position: relative;
}

.feed {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 252, 246, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(90, 70, 40, 0.12);
  color: #6a7a62;
  font-size: 24rpx;
}

.feed-hint {
  position: absolute;
  top: calc(100% + 10rpx);
  right: 0;
  width: 280rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 252, 246, 0.92);
  box-shadow: 0 6rpx 16rpx rgba(90, 70, 40, 0.12);
  color: #6a7a62;
  font-size: 20rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
  z-index: 6;
}

.feed.is-off {
  opacity: 0.38;
}

.leaf-short {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 28;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.leaf-short-card {
  max-width: 560rpx;
  padding: 28rpx 36rpx;
  border-radius: 24rpx;
  background: rgba(255, 252, 246, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(90, 70, 40, 0.16);
  color: #6a7a62;
  text-align: center;
  pointer-events: auto;
}

.leaf-short-line {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.leaf-short-logo {
  width: 40rpx;
  height: 40rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.leaf-short-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.service-wrap {
  position: relative;
  z-index: 7;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.service-logo {
  width: 50rpx;
  height: 50rpx;
  display: block;
}

.service-label {
  margin-top: 4rpx;
  color: #6a7a62;
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.service-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  opacity: 0;
}

.stocks {
  margin-right: 10rpx;
  display: flex;
  flex-direction: column;
  line-height: 1.25;
  font-size: 20rpx;
  color: #6b6256;
  text-align: right;
}

.album {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}

.album-back,
.album-front {
  position: absolute;
  width: 40rpx;
  height: 50rpx;
  border-radius: 6rpx;
  border: 2rpx solid rgba(138, 163, 130, 0.7);
  background: #f7f1e4;
}

.album-back {
  right: 2rpx;
  top: 0;
  transform: rotate(8deg);
  opacity: 0.7;
}

.album-front {
  left: 6rpx;
  top: 6rpx;
}

.dot {
  position: absolute;
  right: -2rpx;
  top: -2rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e25d5d;
  border: 3rpx solid #fff8ee;
  z-index: 2;
}

.travel-remain {
  position: absolute;
  left: 0;
  right: 0;
  top: 38%;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.travel-line-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.travel-line {
  font-size: 28rpx;
  color: rgba(90, 81, 72, 0.72);
  letter-spacing: 6rpx;
}

.travel-away {
  font-size: 24rpx;
  color: rgba(90, 81, 72, 0.62);
  letter-spacing: 2rpx;
}

.travel-time {
  margin-top: 12rpx;
  font-size: 40rpx;
  color: #7d8b74;
  letter-spacing: 4rpx;
}

.cat {
  position: absolute;
  z-index: 2;
}

.guide-cat-hit {
  z-index: 1;
  pointer-events: none;
}

.cat.is-hide {
  opacity: 0;
}

.cat.is-show {
  opacity: 1;
}

.cat-near {
  scale: 0.6;
  right: -30rpx;
  top: auto;

  bottom: 264rpx;
  width: 360rpx;
  height: 300rpx;
  transform: none;
}

.cat-near.cat-sleep {
  scale: 0.61;
  width: 360rpx;
  left: -20rpx;
  height: 197rpx;
  bottom: 188rpx;
}

.cat-near.cat-meal {
  width: 240rpx;
  height: 237rpx;
  scale: 0.4;
  z-index: 3;
  bottom: 429rpx;
}

.cat-near.cat-meal.cat-eat {
  left: 330rpx;
}

.cat-near.cat-meal.cat-drink {
  left: 262rpx;
}

.cat-door {
  left: 576rpx;
  top: auto;
  bottom: 350rpx;
  width: 168rpx;
  height: 200rpx;
  margin-left: -84rpx;
  transform: translateY(-100%);
  scale: 0.65;
}

.cat-bag {
  position: absolute;
  z-index: 2;
  right: 7rpx;
  bottom: 671rpx;
  width: 110rpx;
  height: 110rpx;
  scale: 0.65;
}

.bowls {
  position: absolute;
  right: 170rpx;
  bottom: 494rpx;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  scale: 0.47;
}

.bowl {
  width: 150rpx;
  height: 120rpx;
  /* margin-left: -8rpx; */
}

.welcome {
  position: absolute;
  left: 510rpx;
  bottom: 579rpx;
  z-index: 6;
  width: 280rpx;
  height: 290rpx;
  animation: welcome-in 0.28s ease-out;
  scale: 0.8;
}

.welcome-img {
  scale: 0.6;
  width: 100%;
  height: 100%;
}

.welcome-text {
  position: absolute;
  right: 34%;
  top: 20%;
  height: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #6a7a62;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  pointer-events: none;
}

@keyframes welcome-in {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.identity {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.identity-hover {
  opacity: 0.72;
}

.identity-logo {
  width: 50rpx;
  height: 50rpx;
  margin-right: -10rpx;
}

.identity-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(90, 70, 40, 0.28);
}

.leaf-card {
  min-height: 520rpx;
}

.identity-card {
  position: relative;
  width: 640rpx;
  max-width: 86%;
  padding: 36rpx 36rpx 40rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  border: 2rpx solid rgba(168, 186, 160, 0.55);
  background: rgba(255, 252, 246, 0.97);
  box-shadow: 0 16rpx 40rpx rgba(90, 70, 40, 0.16);
  animation: identity-in 0.22s ease-out;
}

.identity-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  margin-bottom: 28rpx;
}

.identity-title {
  color: #6a7a62;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}

.detail{
  font-size: 22rpx;

}

.identity-close {
  position: absolute;
  right: -8rpx;
  top: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  color: #8a8173;
  font-size: 40rpx;
}

.identity-field {
  margin-top: 8rpx;
}

.identity-field + .identity-field {
  margin-top: 28rpx;
}

.identity-label {
  display: block;
  margin-bottom: 12rpx;
  color: #8a8173;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.identity-line {
  display: flex;
  align-items: flex-start;
}

.identity-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #f7f1e4;
  color: #5a5148;
  font-size: 28rpx;
}

.identity-placeholder {
  color: #b7ad9f;
}

.identity-picker {
  flex: 1;
  min-width: 0;
}

.breed-menu {
  margin-top: 8rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f7f1e4;
}

.breed-option {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  color: #5a5148;
  font-size: 28rpx;
}

.breed-option.is-on {
  color: #5f6d58;
  background: rgba(138, 163, 130, 0.22);
}

.identity-select {
  height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #f7f1e4;
  color: #5a5148;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.identity-select.is-locked {
  color: #8a8173;
}

.identity-chevron {
  width: 12rpx;
  height: 12rpx;
  margin-right: 6rpx;
  border-right: 3rpx solid #8a8173;
  border-bottom: 3rpx solid #8a8173;
  transform: rotate(45deg) translateY(-4rpx);
  flex-shrink: 0;
}

.identity-chevron.is-open {
  transform: rotate(-135deg) translateY(2rpx);
}

.identity-save {
  margin-left: 16rpx;
  padding: 0 22rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  background: #8aa382;
  color: #fffdf8;
  font-size: 26rpx;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.identity-save.is-busy {
  opacity: 0.45;
}

.identity-note,
.identity-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.identity-note {
  color: #9a9083;
}

.identity-hint {
  color: #b07a45;
}

.identity-hint.is-locked {
  color: #9a9083;
}

.identity-stand {
  display: block;
  width: 100%;
  height: 220rpx;
  margin-top: 20rpx;
}

.identity-more {
  margin-top: 16rpx;
  color: #9a9083;
  font-size: 22rpx;
  line-height: 1.6;
}

.identity-contact {
  display: inline;
  width: auto;
  min-height: 0;
  height: auto;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  color: #6a7a62;
  font-size: 22rpx;
  line-height: 1.6;
  text-decoration: underline;
}

.identity-debug {
  display: flex;
  align-items: center;
  /* justify-content: space-between; */
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(168, 186, 160, 0.4);
}

.identity-info {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  box-sizing: border-box;
  border: 2rpx solid #8a8173;
  border-radius: 50%;
  flex-shrink: 0;
}

.identity-info::before,
.identity-info::after {
  content: "";
  position: absolute;
  left: 50%;
  background: #8a8173;
  transform: translateX(-50%);
}

.identity-info::before {
  top: 7rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
}

.identity-info::after {
  top: 14rpx;
  width: 3rpx;
  height: 12rpx;
  border-radius: 2rpx;
}

.identity-debug-copy {
  margin-left: 20rpx;
  color: #6a7a62;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: right;
}

.identity-debug-copy-hover {
  opacity: 0.72;
}

.help-wrap {
  margin-top: 16rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.help-hover {
  opacity: 0.72;
}

.help-logo {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: rgba(255, 252, 246, 0.9);
  box-shadow: 0 6rpx 16rpx rgba(90, 70, 40, 0.12);
  color: #6a7a62;
  font-size: 20rpx;
  line-height: 50rpx;
  text-align: center;
}

.guide {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(0, 0, 0, 0.55);
}

.guide.is-ready {
  background: transparent;
}

.guide-hole {
  position: absolute;
  z-index: 1;
  border-radius: 20rpx;
  box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.55);
}

.guide-tip {
  position: absolute;
  z-index: 2;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 252, 246, 0.96);
  box-shadow: 0 8rpx 24rpx rgba(40, 30, 10, 0.16);
  color: #5c5348;
  font-size: 26rpx;
  line-height: 1.55;
}

.guide-line {
  display: block;
}

.guide-skip {
  position: absolute;
  z-index: 3;
  color: #fff;
  font-size: 28rpx;
  line-height: 32px;
  height: 32px;
  padding: 0 4px;
  letter-spacing: 2rpx;
}

.debug-dock {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 36rpx;
  z-index: 35;
}

.debug-toggle {
  align-self: flex-start;
  display: inline-block;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 246, 0.92);
  color: #6a7a62;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.debug-toggle-hover {
  opacity: 0.72;
}

.debug-panel {
  margin-top: 12rpx;
  padding: 16rpx 16rpx 8rpx;
  border-radius: 24rpx;
  background: rgba(255, 252, 246, 0.94);
  box-shadow: 0 8rpx 24rpx rgba(90, 70, 40, 0.12);
}

.debug-note {
  display: block;
  margin: 0 8rpx 12rpx;
  color: rgba(106, 122, 98, 0.8);
  font-size: 20rpx;
  line-height: 1.4;
}

.debug-grid {
  display: flex;
  flex-wrap: wrap;
}

.debug-chip {
  margin: 0 8rpx 12rpx 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(243, 234, 216, 0.9);
  color: #5c5348;
  font-size: 22rpx;
  line-height: 1.4;
}

.debug-chip.is-on {
  background: #6a7a62;
  color: #fff;
}

.debug-chip-back {
  background: rgba(106, 122, 98, 0.16);
}

@keyframes identity-in {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
