page {
  height: 100%;
  background: #f3ead8;
  overflow: hidden;
}

.home {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hud {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 5;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.status-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-remain {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(106, 122, 98, 0.7);
  letter-spacing: 1rpx;
}

.status {
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 246, 0.82);
  color: #6a7a62;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.tools-row {
  display: flex;
  gap: 15px;
  flex-direction: column;
  align-items: end;
  margin-right: 20px;
}

.feed-row {
  display: flex;
}

.feed {
  width: 56rpx;
  height: 56rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: rgba(255, 252, 246, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(90, 70, 40, 0.12);
  color: #6a7a62;
  font-size: 24rpx;
}

.feed.is-off {
  opacity: 0.38;
}

.stocks {
  margin-right: 10rpx;
  display: flex;
  flex-direction: column;
  line-height: 1.25;
  font-size: 20rpx;
  color: #6b6256;
  text-align: right;
}

.album {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}

.album-back,
.album-front {
  position: absolute;
  width: 40rpx;
  height: 50rpx;
  border-radius: 6rpx;
  border: 2rpx solid rgba(138, 163, 130, 0.7);
  background: #f7f1e4;
}

.album-back {
  right: 2rpx;
  top: 0;
  transform: rotate(8deg);
  opacity: 0.7;
}

.album-front {
  left: 6rpx;
  top: 6rpx;
}

.dot {
  position: absolute;
  right: -2rpx;
  top: -2rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e25d5d;
  border: 3rpx solid #fff8ee;
  z-index: 2;
}

.travel-remain {
  position: absolute;
  left: 0;
  right: 0;
  top: 38%;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.travel-line-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 16rpx;
}

.travel-line {
  font-size: 28rpx;
  color: rgba(90, 81, 72, 0.72);
  letter-spacing: 6rpx;
}

.travel-away {
  font-size: 24rpx;
  color: rgba(90, 81, 72, 0.62);
  letter-spacing: 2rpx;
}

.travel-time {
  margin-top: 12rpx;
  font-size: 40rpx;
  color: #7d8b74;
  letter-spacing: 4rpx;
}

.cat {
  position: absolute;
  z-index: 2;
}

.cat.is-hide {
  opacity: 0;
}

.cat.is-show {
  opacity: 1;
}

.cat-near {
  left: 90rpx;
  top: auto;
  bottom: 70rpx;
  bottom: calc(90rpx + constant(safe-area-inset-bottom));
  bottom: calc(90rpx + env(safe-area-inset-bottom));
  width: 360rpx;
  height: 300rpx;
  transform: none;
}

.cat-near.cat-sleep {
  width: 360rpx;
  height: 197rpx;
}

.cat-near.cat-eat {
  width: 360rpx;
  height: 250rpx;
}

.cat-door {
  left: 70%;
  top: 80%;
  bottom: auto;
  width: 168rpx;
  height: 200rpx;
  margin-left: -84rpx;
  transform: translateY(-100%);
}

.bowls {
  position: absolute;
  right: -70rpx;
  bottom: 75rpx;
  bottom: calc(75rpx + constant(safe-area-inset-bottom));
  bottom: calc(75rpx + env(safe-area-inset-bottom));
  z-index: 2;
  display: flex;
  align-items: flex-end;
}

.bowl {
  width: 150rpx;
  height: 120rpx;
  /* margin-left: -8rpx; */
}

.welcome {
  position: absolute;
  left: 490rpx;
  bottom: 400rpx;
  bottom: calc(320rpx + constant(safe-area-inset-bottom));
  bottom: calc(460rpx + env(safe-area-inset-bottom));
  z-index: 6;
  width: 280rpx;
  height: 290rpx;
  animation: welcome-in 0.28s ease-out;
  scale: 0.8;
}

.welcome-img {
  width: 100%;
  height: 100%;
}

.welcome-text {
  position: absolute;
  left: 16%;
  right: 14%;
  top: 16%;
  height: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #6a7a62;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  pointer-events: none;
}

@keyframes welcome-in {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
